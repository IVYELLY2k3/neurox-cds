run = "cd backend && pip install -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000"
entrypoint = "backend/main.py"

[deployment]
run = ["sh", "-c", "cd backend && pip install -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80
